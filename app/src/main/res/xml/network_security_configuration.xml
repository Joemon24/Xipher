<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Allow cleartext for localhost and Loki -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">public.loki.foundation</domain>
    </domain-config>

    <!-- Trust system CA for official getsession.org domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">getsession.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Trust self-signed cert for custom seed1 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">seed1.getsession.org</domain>
        <trust-anchors>
            <certificates src="@raw/seed1" />
        </trust-anchors>
    </domain-config>

    <!-- Trust self-signed cert for custom seed2 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">seed2.getsession.org</domain>
        <trust-anchors>
            <certificates src="@raw/seed2" />
        </trust-anchors>
    </domain-config>

    <!-- Trust self-signed cert for custom seed3 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">seed3.getsession.org</domain>
        <trust-anchors>
            <certificates src="@raw/seed3" />
        </trust-anchors>
    </domain-config>

</network-security-config>